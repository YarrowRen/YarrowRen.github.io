---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import fs from "fs";
import path from "path";
import sharp from "sharp";

const { album } = Astro.params;
const albumPath = `/assets/gallery/${album}`;
const absoluteDir = path.resolve("public" + albumPath);

// 读取相册图片，并在构建期获取尺寸以防止布局跳动
interface ImageMeta { src: string; width: number; height: number }
let images: ImageMeta[] = [];

if (fs.existsSync(absoluteDir)) {
  const files = fs
    .readdirSync(absoluteDir)
    .filter((file) => /\.(jpg|jpeg|png|webp)$/i.test(file));

  images = await Promise.all(
    files.map(async (file) => {
      const src = `${albumPath}/${file}`;
      const { width, height } = await sharp(path.join(absoluteDir, file)).metadata();
      return { src, width: width ?? 800, height: height ?? 600 };
    })
  );
}

// 读取 meta.json
let meta: any = {};
const metaPath = path.join(absoluteDir, "meta.json");
if (fs.existsSync(metaPath)) {
  try {
    meta = JSON.parse(fs.readFileSync(metaPath, "utf-8"));
  } catch (e) {
    console.error(`读取 meta.json 失败: ${album}`, e);
  }
}

// 提取经纬度
let latitude = null;
let longitude = null;

if (meta.location && meta.location.includes(",")) {
  [latitude, longitude] = meta.location.split(",").map(Number);
}

// 动态路径生成
export async function getStaticPaths() {
  const baseDir = path.resolve("public/assets/gallery");
  const albums = fs.existsSync(baseDir)
    ? fs.readdirSync(baseDir).filter((name) =>
        fs.statSync(path.join(baseDir, name)).isDirectory()
      )
    : [];

  return albums.map((name) => ({
    params: { album: name },
  }));
}
---

<Layout noindex={true}>
  <Header />

  <main id="main-content" class="max-w-6xl mx-auto p-4">
    <h1 class="text-3xl font-bold mb-2">📸 {meta.title || album}</h1>
    {meta.date && <p class="text-gray-500">{meta.date}</p>}
    {meta.description && <p class="mt-2">{meta.description}</p>}

    {latitude && longitude && (
      <div class="mt-6 mb-8">
        <iframe
          src={`https://maps.google.com/maps?q=${latitude},${longitude}&z=14&output=embed`}
          width="100%"
          height="250"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    )}

    <div class="columns-1 sm:columns-2 lg:columns-3 gap-4" id="gallery-container">
      {images.map((img, index) => (
        <a href={img.src} class="mb-4 break-inside-avoid block">
          <img
            src={img.src}
            width={img.width}
            height={img.height}
            alt={`Image ${index}`}
            class="rounded-lg transition-transform duration-300 hover:scale-105 gallery-image"
            loading="lazy"
          />
        </a>
      ))}
    </div>
  </main>

  <Footer />

  <script>
    import lightGallery from 'lightgallery';
    import lgZoom from 'lightgallery/plugins/zoom';
    import 'lightgallery/css/lightgallery.css';
    import 'lightgallery/css/lg-zoom.css';

    let lgInstance: ReturnType<typeof lightGallery> | null = null;
    const lightboxBgStorageKey = 'lightgallery-background-mode';

    function getLightboxBgMode() {
      return localStorage.getItem(lightboxBgStorageKey) === 'black' ? 'black' : 'white';
    }

    function applyLightboxBgMode(root: HTMLElement, mode: 'black' | 'white') {
      root.classList.toggle('lg-bg-white', mode === 'white');
      root.classList.toggle('lg-bg-black', mode !== 'white');
    }

    function attachLightboxBgToggle(instance: ReturnType<typeof lightGallery>) {
      const lgAny = instance as any;
      const onAfterOpen = () => {
        const container = lgAny.$container?.get?.() as HTMLElement | undefined;
        const toolbar = lgAny.$toolbar?.get?.() as HTMLElement | undefined;
        if (!container || !toolbar) return;

        applyLightboxBgMode(container, getLightboxBgMode());

        let toggleButton = toolbar.querySelector<HTMLButtonElement>('.lg-bg-toggle');
        if (!toggleButton) {
          toggleButton = document.createElement('button');
          toggleButton.type = 'button';
          toggleButton.className = 'lg-bg-toggle lg-icon';
          toolbar.appendChild(toggleButton);

          toggleButton.addEventListener('click', () => {
            const nextMode = container.classList.contains('lg-bg-white') ? 'black' : 'white';
            localStorage.setItem(lightboxBgStorageKey, nextMode);
            applyLightboxBgMode(container, nextMode);
            toggleButton?.setAttribute(
              'aria-label',
              nextMode === 'white' ? '切换为黑色背景' : '切换为白色背景'
            );
            toggleButton?.setAttribute(
              'title',
              nextMode === 'white' ? '切换为黑色背景' : '切换为白色背景'
            );
          });
        }

        const mode = container.classList.contains('lg-bg-white') ? 'white' : 'black';
        toggleButton.setAttribute(
          'aria-label',
          mode === 'white' ? '切换为黑色背景' : '切换为白色背景'
        );
        toggleButton.setAttribute(
          'title',
          mode === 'white' ? '切换为黑色背景' : '切换为白色背景'
        );
      };

      lgAny.LGel?.off?.('lgAfterOpen.bgToggle');
      lgAny.LGel?.on?.('lgAfterOpen.bgToggle', onAfterOpen);
    }

    function initGallery() {
      if (lgInstance) { lgInstance.destroy(); lgInstance = null; }
      const container = document.getElementById('gallery-container');
      if (!container) return;
      lgInstance = lightGallery(container, {
        selector: 'a',
        plugins: [lgZoom],
        speed: 400,
        zoom: true,
        showZoomInOutIcons: true,
        actualSize: false,
        download: false,
        licenseKey: '0000-0000-000-0000',
      });
      attachLightboxBgToggle(lgInstance);
    }

    document.addEventListener('astro:page-load', initGallery);
  </script>

  <style is:global>
    /* Gallery Images Styling */
    .gallery-image {
      width: 100%;
      height: auto;
      display: block;
    }
  </style>
</Layout>
