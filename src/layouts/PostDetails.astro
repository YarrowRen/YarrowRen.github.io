---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import Comments from "@/components/Comments.tsx";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

const { Content } = await render(post);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, SITE.website).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id }) => ({
  slug: id,
  title,
}));

const currentPostIndex = allPosts.findIndex(a => a.slug === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;
---

<Layout {...layoutProps}>
  <Header />
  
  <main
    id="main-content"
    class:list={[
      "mx-auto w-full max-w-[960px] px-4 pb-12 mt-8",
    ]}
    data-pagefind-body
  >
    <!-- TOC Sidebar -->
    <div id="toc-sidebar" class="toc-sidebar hidden lg:block">
      <div id="toc-content" class="toc-content">
        <!-- TOC will be moved here by JavaScript -->
      </div>
    </div>
    <h1
      transition:name={slugifyStr(title)}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>
    <div class="flex items-center gap-4">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" class="my-2" />
      <!-- <EditPost class="max-sm:hidden" {hideEditPost} {post} /> -->
    </div>
    <article id="article" class="mx-auto prose mt-8 max-w-[960px]">
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ul class="mt-4 mb-8 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} />)}
    </ul>

    <div
      class="flex flex-col items-center justify-between gap-6 sm:flex-row sm:items-end sm:gap-4"
    >
      <ShareLinks />

      <button
        id="back-to-top"
        class="focus-outline py-1 whitespace-nowrap hover:opacity-75"
      >
        <IconChevronLeft class="inline-block rotate-90" />
        <span>Back to Top</span>
      </button>
    </div>

    <hr class="my-6 border-dashed" />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={`/posts/${prevPost.slug}`}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none" />
            <div>
              <span>Previous Post</span>
              <div class="text-sm text-accent/85">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={`/posts/${nextPost.slug}`}
            class="flex w-full justify-end gap-1 text-right hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>Next Post</span>
              <div class="text-sm text-accent/85">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none" />
          </a>
        )
      }
    </div>


    <hr class="my-6 border-dashed" />

    <!-- Comments Section -->
    <Comments client:load slug={post.id} />
  </main>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      // Generate ID from heading text if not exists
      if (!heading.id) {
        const text = heading.textContent || "";
        heading.id = text
          .toLowerCase()
          .replace(/[^\w\u4e00-\u9fff\s-]/g, "") // Keep alphanumeric, Chinese, spaces, hyphens
          .replace(/\s+/g, "-") // Replace spaces with hyphens
          .replace(/^-|-$/g, ""); // Remove leading/trailing hyphens
      }
      
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ml-2 opacity-0 group-hover:opacity-100 focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre")).filter(
      codeBlock => !!codeBlock.querySelector("code")
    );

    for (const codeBlock of codeBlocks) {
      if (codeBlock.querySelector(".copy-code")) continue;

      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const copyButton = document.createElement("button");
      copyButton.className =
        "copy-code absolute right-3 -top-3 rounded bg-muted px-2 py-1 text-xs leading-4 text-foreground font-medium";
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();
  document.addEventListener("astro:page-load", attachCopyButtons);

  /** Scrolls the document to the top when
   * the "Back to Top" button is clicked. */
  function backToTop() {
    document.querySelector("#back-to-top")?.addEventListener("click", () => {
      document.body.scrollTop = 0; // For Safari
      document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    });
  }
  backToTop();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );

  /** Generate TOC automatically from headings */
  function generateTOC() {
    console.log("Starting generateTOC function");
    const tocSidebar = document.getElementById("toc-sidebar");
    const tocContent = document.getElementById("toc-content");
    
    if (!tocSidebar || !tocContent) {
      console.log("Missing TOC elements, returning");
      return;
    }

    // Find all headings in the article (h1, h2, h3, h4, h5, h6) - excluding the page title
    const headings = Array.from(document.querySelectorAll("article h1, article h2, article h3, article h4, article h5, article h6"))
      .filter(heading => heading.id !== 'table-of-contents'); // Exclude the old TOC heading
    console.log("Found headings:", headings.length);

    if (headings.length === 0) {
      console.log("No headings found, not showing TOC");
      return;
    }

    // Remove any existing "Table of contents" heading and its content
    const existingTocHeading = document.querySelector('article h1#table-of-contents');
    if (existingTocHeading) {
      existingTocHeading.remove();
    }

    // Generate TOC HTML
    const tocList = generateTOCList(headings);
    tocContent.appendChild(tocList);
    
    // Function to handle TOC display based on screen size
    const handleTOCDisplay = () => {
      if (window.innerWidth >= 1280) {
        tocSidebar.classList.remove("hidden");
        document.body.classList.add("has-toc");
      } else {
        tocSidebar.classList.add("hidden");
        document.body.classList.remove("has-toc");
      }
    };
    
    // Initial setup
    handleTOCDisplay();
    
    // Listen for window resize
    window.addEventListener('resize', handleTOCDisplay);
    console.log("TOC generated and moved to sidebar");
    
    // Initialize TOC scroll behavior
    initializeTOCBehavior();
  }
  
  /** Initialize TOC floating behavior */
  function initializeTOCBehavior() {
    const tocSidebar = document.getElementById("toc-sidebar");
    const mainContent = document.getElementById("main-content");
    const header = document.querySelector("header");
    if (!tocSidebar || !mainContent) return;
    
    // Update TOC position and height based on scroll and header visibility
    function updateTOCPosition() {
      const scrollY = window.scrollY;
      
      // Calculate how much of header is still visible
      const headerHeight = header ? header.offsetHeight : 0;
      const headerVisible = Math.max(0, headerHeight - scrollY);
      
      // TOC should be positioned relative to viewport top, considering visible header
      // When header is fully visible: headerVisible + 20px offset
      // When header is hidden: 20px from top
      const topOffset = headerVisible + 20;
      
      // Calculate dynamic height to fill remaining viewport
      const bottomPadding = 20; // Bottom margin
      const availableHeight = window.innerHeight - topOffset - bottomPadding;
      
      tocSidebar.style.top = `${topOffset}px`;
      tocSidebar.style.maxHeight = `${availableHeight}px`;
      
      // Update toc-content height accordingly
      const tocContent = tocSidebar.querySelector('.toc-content');
      if (tocContent) {
        const contentPadding = 32; // 16px padding top + 16px padding bottom
        tocContent.style.maxHeight = `${availableHeight - contentPadding}px`;
      }
    }
    
    // Function to update active TOC links based on scroll position
    function updateActiveTOCLink() {
      const headings = document.querySelectorAll('article h1[id], article h2[id], article h3[id], article h4[id], article h5[id], article h6[id]');
      const tocLinks = document.querySelectorAll('.toc-content a[href^="#"]');
      
      if (!headings.length || !tocLinks.length) return;
      
      // Find the current heading in viewport
      let current = null;
      const scrollY = window.scrollY;
      const offset = 100; // Offset from top of viewport
      
      for (let i = headings.length - 1; i >= 0; i--) {
        const heading = headings[i];
        const rect = heading.getBoundingClientRect();
        const headingTop = scrollY + rect.top;
        
        if (headingTop <= scrollY + offset) {
          current = heading.id;
          break;
        }
      }
      
      // Remove all active classes
      tocLinks.forEach(link => link.classList.remove('toc-active'));
      
      // Add active class to current heading's TOC link
      if (current) {
        const activeLink = document.querySelector(`.toc-content a[href="#${current}"]`);
        if (activeLink) {
          activeLink.classList.add('toc-active');
        }
      }
    }

    // Throttled scroll handler for better performance
    let ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateTOCPosition();
          updateActiveTOCLink();
          ticking = false;
        });
        ticking = true;
      }
    }
    
    window.addEventListener('scroll', onScroll);
    window.addEventListener('resize', updateTOCPosition);
    updateTOCPosition(); // Initial call
    updateActiveTOCLink(); // Initial active link detection
  }

  function generateTOCList(headings) {
    if (headings.length === 0) return document.createElement("ul");
    
    // Find the minimum heading level in the document
    const minLevel = Math.min(...headings.map(h => parseInt(h.tagName.charAt(1))));
    
    const ul = document.createElement("ul");
    const stack = [{ level: minLevel - 1, ul: ul }];

    headings.forEach(heading => {
      // Generate ID if not exists
      if (!heading.id) {
        const text = heading.textContent || "";
        heading.id = text
          .toLowerCase()
          .replace(/[^\w\u4e00-\u9fff\s-]/g, "") // Keep alphanumeric, Chinese, spaces, hyphens
          .replace(/\s+/g, "-") // Replace spaces with hyphens
          .replace(/^-|-$/g, ""); // Remove leading/trailing hyphens
      }

      const level = parseInt(heading.tagName.charAt(1)); // h2 -> 2, h3 -> 3, etc.
      const text = (heading.textContent || "").replace(/#$/, "").trim(); // Remove trailing # and whitespace
      
      // Find the appropriate parent level
      while (stack.length > 1 && stack[stack.length - 1].level >= level) {
        stack.pop();
      }

      // Create new nested list if needed
      if (stack[stack.length - 1].level < level) {
        const nestedUl = document.createElement("ul");
        const lastLi = stack[stack.length - 1].ul.lastElementChild;
        if (lastLi) {
          lastLi.appendChild(nestedUl);
        } else {
          stack[stack.length - 1].ul.appendChild(nestedUl);
        }
        stack.push({ level: level, ul: nestedUl });
      }

      // Create list item and link
      const li = document.createElement("li");
      
      // Add data attribute to indicate the actual heading level
      li.setAttribute('data-heading-level', level);
      
      const a = document.createElement("a");
      a.href = "#" + heading.id;
      a.textContent = text;
      li.appendChild(a);
      
      stack[stack.length - 1].ul.appendChild(li);
    });

    return ul;
  }
  generateTOC();
</script>

<script>
  import lightGallery from 'lightgallery';
  import lgZoom from 'lightgallery/plugins/zoom';
  import 'lightgallery/css/lightgallery.css';
  import 'lightgallery/css/lg-zoom.css';

  let lgInstance: ReturnType<typeof lightGallery> | null = null;
  const lightboxBgStorageKey = 'lightgallery-background-mode';

  function getLightboxBgMode() {
    return localStorage.getItem(lightboxBgStorageKey) === 'black' ? 'black' : 'white';
  }

  function applyLightboxBgMode(root: HTMLElement, mode: 'black' | 'white') {
    root.classList.toggle('lg-bg-white', mode === 'white');
    root.classList.toggle('lg-bg-black', mode !== 'white');
  }

  function attachLightboxBgToggle(instance: ReturnType<typeof lightGallery>) {
    const lgAny = instance as any;
    const onAfterOpen = () => {
      const container = lgAny.$container?.get?.() as HTMLElement | undefined;
      const toolbar = lgAny.$toolbar?.get?.() as HTMLElement | undefined;
      if (!container || !toolbar) return;

      applyLightboxBgMode(container, getLightboxBgMode());

      let toggleButton = toolbar.querySelector<HTMLButtonElement>('.lg-bg-toggle');
      if (!toggleButton) {
        toggleButton = document.createElement('button');
        toggleButton.type = 'button';
        toggleButton.className = 'lg-bg-toggle lg-icon';
        toolbar.appendChild(toggleButton);

        toggleButton.addEventListener('click', () => {
          const nextMode = container.classList.contains('lg-bg-white') ? 'black' : 'white';
          localStorage.setItem(lightboxBgStorageKey, nextMode);
          applyLightboxBgMode(container, nextMode);
          toggleButton?.setAttribute(
            'aria-label',
            nextMode === 'white' ? '切换为黑色背景' : '切换为白色背景'
          );
          toggleButton?.setAttribute(
            'title',
            nextMode === 'white' ? '切换为黑色背景' : '切换为白色背景'
          );
        });
      }

      const mode = container.classList.contains('lg-bg-white') ? 'white' : 'black';
      toggleButton.setAttribute(
        'aria-label',
        mode === 'white' ? '切换为黑色背景' : '切换为白色背景'
      );
      toggleButton.setAttribute(
        'title',
        mode === 'white' ? '切换为黑色背景' : '切换为白色背景'
      );
    };

    lgAny.LGel?.off?.('lgAfterOpen.bgToggle');
    lgAny.LGel?.on?.('lgAfterOpen.bgToggle', onAfterOpen);
  }

  function enableImageLightbox() {
    if (lgInstance) { lgInstance.destroy(); lgInstance = null; }
    const article = document.getElementById('article');
    if (!article) return;

    const imgs = Array.from(article.querySelectorAll('img'))
      .filter(img => !img.closest('a'));
    if (!imgs.length) return;

    const dynamicEl = imgs.map(img => ({
      src: img.src,
      thumb: img.src,
      alt: img.alt || '',
    }));

    lgInstance = lightGallery(document.body, {
      dynamic: true,
      dynamicEl,
      plugins: [lgZoom],
      speed: 400,
      zoom: true,
      showZoomInOutIcons: true,
      actualSize: false,
      download: false,
      licenseKey: '0000-0000-000-0000',
    });
    attachLightboxBgToggle(lgInstance);

    imgs.forEach((img, idx) => {
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', () => lgInstance!.openGallery(idx));
    });
  }

  document.addEventListener('astro:page-load', enableImageLightbox);
</script>
