---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import Comments from "@/components/Comments.tsx";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  hideToc,
} = post.data;

const { Content } = await render(post);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, SITE.website).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  slug: getPath(id, filePath, true),
  title,
}));

const currentSlug = getPath(post.id, post.filePath, true);
const currentPostIndex = allPosts.findIndex(a => a.slug === currentSlug);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex + 1 < allPosts.length ? allPosts[currentPostIndex + 1] : null;
---

<Layout {...layoutProps}>
  <Header />
  
  <main
    id="main-content"
    class:list={[
      "mx-auto w-full max-w-[960px] px-4 pb-12 mt-8",
    ]}
    data-pagefind-body
  >
    <!-- TOC Sidebar -->
    {!hideToc && (
      <div id="toc-sidebar" class="toc-sidebar toc-user-hidden">
        <div id="toc-content" class="toc-content">
          <!-- TOC will be moved here by JavaScript -->
        </div>
      </div>
    )}
    <h1
      transition:name={slugifyStr(title)}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>
    <div class="flex items-center gap-4">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" class="my-2" />
      <!-- <EditPost class="max-sm:hidden" {hideEditPost} {post} /> -->
    </div>
    <article id="article" class="mx-auto prose mt-8 max-w-[960px]">
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ul class="mt-4 mb-8 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} />)}
    </ul>

    <div
      class="flex flex-col items-center justify-between gap-6 sm:flex-row sm:items-end sm:gap-4"
    >
      <ShareLinks />

      <button
        id="back-to-top"
        class="focus-outline py-1 whitespace-nowrap hover:opacity-75"
      >
        <IconChevronLeft class="inline-block rotate-90" />
        <span>Back to Top</span>
      </button>
    </div>

    <hr class="my-6 border-dashed" />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={prevPost.slug}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none" />
            <div>
              <span>Previous Post</span>
              <div class="text-sm text-accent/85">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={nextPost.slug}
            class="flex w-full justify-end gap-1 text-right hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>Next Post</span>
              <div class="text-sm text-accent/85">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none" />
          </a>
        )
      }
    </div>


    <hr class="my-6 border-dashed" />

    <!-- Comments Section -->
    <Comments client:load slug={post.id} />
  </main>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
(function () {
  // ── Cleanup previous instance to prevent listener accumulation ──
  if (typeof window.__tocCleanup === 'function') window.__tocCleanup();

  const _ctrl = new AbortController();
  const { signal } = _ctrl;

  window.__tocCleanup = () => {
    _ctrl.abort();
    document.querySelectorAll('.toc-backdrop, .toc-toggle-tab').forEach(el => el.remove());
  };

  // Cleanup before next page swap
  document.addEventListener('astro:before-swap', () => {
    window.__tocCleanup?.();
    window.__tocCleanup = null;
  }, { signal, once: true });

  // ── Progress Bar ──
  function createProgressBar() {
    const progressContainer = document.createElement("div");
    progressContainer.className = "progress-container fixed top-0 z-10 h-1 w-full bg-background";
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";
    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  window.addEventListener("scroll", () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const myBar = document.getElementById("myBar");
    if (myBar) myBar.style.width = ((winScroll / height) * 100) + "%";
  }, { signal });

  // ── Heading Links ──
  function addHeadingLinks() {
    for (const heading of document.querySelectorAll("h2, h3, h4, h5, h6")) {
      if (!heading.id) {
        heading.id = (heading.textContent || "")
          .toLowerCase()
          .replace(/[^\w\u4e00-\u9fff\s-]/g, "")
          .replace(/\s+/g, "-")
          .replace(/^-|-$/g, "");
      }
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className = "heading-link ml-2 opacity-0 group-hover:opacity-100 focus:opacity-100";
      link.href = "#" + heading.id;
      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  // ── Copy Buttons ──
  function attachCopyButtons() {
    for (const codeBlock of document.querySelectorAll("pre")) {
      if (!codeBlock.querySelector("code") || codeBlock.querySelector(".copy-code")) continue;
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";
      const copyButton = document.createElement("button");
      copyButton.className = "copy-code absolute right-3 -top-3 rounded bg-muted px-2 py-1 text-xs leading-4 text-foreground font-medium";
      copyButton.innerHTML = "Copy";
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);
      codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);
      copyButton.addEventListener("click", async () => {
        const text = codeBlock.querySelector("code")?.innerText ?? "";
        await navigator.clipboard.writeText(text);
        copyButton.innerText = "Copied";
        setTimeout(() => { copyButton.innerText = "Copy"; }, 700);
      });
    }
  }
  attachCopyButtons();
  document.addEventListener("astro:page-load", attachCopyButtons, { signal });

  // ── Back to Top ──
  document.querySelector("#back-to-top")?.addEventListener("click", () => {
    document.body.scrollTop = 0;
    document.documentElement.scrollTop = 0;
  }, { signal });

  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  , { signal });

  // ── TOC ──
  function buildTOCList(headings) {
    if (!headings.length) return document.createElement("ul");
    const minLevel = Math.min(...headings.map(h => parseInt(h.tagName[1])));
    const ul = document.createElement("ul");
    const stack = [{ level: minLevel - 1, ul }];

    for (const heading of headings) {
      const level = parseInt(heading.tagName[1]);
      // IDs already set by addHeadingLinks(); no need to generate again
      const text = (heading.textContent || "").replace(/#$/, "").trim();

      while (stack.length > 1 && stack[stack.length - 1].level >= level) stack.pop();
      if (stack[stack.length - 1].level < level) {
        const nested = document.createElement("ul");
        const lastLi = stack[stack.length - 1].ul.lastElementChild;
        (lastLi ?? stack[stack.length - 1].ul).appendChild(nested);
        stack.push({ level, ul: nested });
      }
      const li = document.createElement("li");
      li.setAttribute("data-heading-level", level);
      const a = document.createElement("a");
      a.href = "#" + heading.id;
      a.textContent = text;
      li.appendChild(a);
      stack[stack.length - 1].ul.appendChild(li);
    }
    return ul;
  }

  function initTOCBehavior() {
    const tocSidebar = document.getElementById("toc-sidebar");
    if (!tocSidebar) return;

    function updateActiveLink() {
      const headings = tocSidebar.closest('body')
        ?.querySelectorAll('article h1[id], article h2[id], article h3[id], article h4[id], article h5[id], article h6[id]');
      const tocLinks = tocSidebar.querySelectorAll('.toc-content a[href^="#"]');
      if (!headings?.length || !tocLinks.length) return;

      let current = null;
      for (let i = headings.length - 1; i >= 0; i--) {
        if (headings[i].getBoundingClientRect().top <= 100) {
          current = headings[i].id;
          break;
        }
      }
      tocLinks.forEach(l => l.classList.remove('toc-active'));
      if (current) tocSidebar.querySelector(`.toc-content a[href="#${current}"]`)?.classList.add('toc-active');
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { updateActiveLink(); ticking = false; });
        ticking = true;
      }
    }, { signal });
    updateActiveLink();
  }

  function generateTOC() {
    const tocSidebar = document.getElementById("toc-sidebar");
    const tocContent = document.getElementById("toc-content");
    if (!tocSidebar || !tocContent) return;

    tocContent.innerHTML = '';
    document.querySelector('article h1#table-of-contents')?.remove();

    const headings = Array.from(
      document.querySelectorAll("article h1, article h2, article h3, article h4, article h5, article h6")
    ).filter(h => h.id !== 'table-of-contents');

    if (!headings.length) return;

    const chevronL = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>`;
    const chevronR = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>`;

    tocContent.appendChild(buildTOCList(headings));

    // ── Toggle tab ──
    const tab = document.createElement('button');
    tab.className = 'toc-toggle-tab toc-tab-visible';
    const tabLabel = document.createElement('span');
    tabLabel.className = 'toc-tab-label';
    tabLabel.textContent = '目录';
    tab.appendChild(tabLabel);
    document.body.appendChild(tab);

    // ── Backdrop (small screens) ──
    const backdrop = document.createElement('div');
    backdrop.className = 'toc-backdrop';
    document.body.appendChild(backdrop);

    const hide = () => {
      tocSidebar.classList.add('toc-user-hidden');
      backdrop.classList.remove('visible');
      tab.innerHTML = chevronR;
      tab.setAttribute('title', '显示目录');
    };

    const show = () => {
      tocSidebar.classList.remove('toc-user-hidden');
      backdrop.classList.add('visible');
      tab.innerHTML = chevronL;
      tab.setAttribute('title', '隐藏目录');
    };

    tab.addEventListener('click', () => {
      tocSidebar.classList.contains('toc-user-hidden') ? show() : hide();
    }, { signal });
    backdrop.addEventListener('click', hide, { signal });

    // Always start hidden — overlay blocks content, not suitable to persist open state
    tocSidebar.style.transition = 'none';
    tocSidebar.classList.add('toc-user-hidden');
    tab.innerHTML = chevronR;
    tab.setAttribute('title', '显示目录');
    requestAnimationFrame(() => { tocSidebar.style.transition = ''; });

    initTOCBehavior();
  }

  generateTOC();
})();
</script>

<script>
  import lightGallery from 'lightgallery';
  import lgZoom from 'lightgallery/plugins/zoom';
  import 'lightgallery/css/lightgallery.css';
  import 'lightgallery/css/lg-zoom.css';

  let lgInstance: ReturnType<typeof lightGallery> | null = null;
  const lightboxBgStorageKey = 'lightgallery-background-mode';

  function getLightboxBgMode() {
    return localStorage.getItem(lightboxBgStorageKey) === 'black' ? 'black' : 'white';
  }

  function applyLightboxBgMode(root: HTMLElement, mode: 'black' | 'white') {
    root.classList.toggle('lg-bg-white', mode === 'white');
    root.classList.toggle('lg-bg-black', mode !== 'white');
  }

  function attachLightboxBgToggle(instance: ReturnType<typeof lightGallery>) {
    const lgAny = instance as any;
    const onAfterOpen = () => {
      const container = lgAny.$container?.get?.() as HTMLElement | undefined;
      const toolbar = lgAny.$toolbar?.get?.() as HTMLElement | undefined;
      if (!container || !toolbar) return;

      applyLightboxBgMode(container, getLightboxBgMode());

      let toggleButton = toolbar.querySelector<HTMLButtonElement>('.lg-bg-toggle');
      if (!toggleButton) {
        toggleButton = document.createElement('button');
        toggleButton.type = 'button';
        toggleButton.className = 'lg-bg-toggle lg-icon';
        toolbar.appendChild(toggleButton);

        toggleButton.addEventListener('click', () => {
          const nextMode = container.classList.contains('lg-bg-white') ? 'black' : 'white';
          localStorage.setItem(lightboxBgStorageKey, nextMode);
          applyLightboxBgMode(container, nextMode);
          toggleButton?.setAttribute(
            'aria-label',
            nextMode === 'white' ? '切换为黑色背景' : '切换为白色背景'
          );
          toggleButton?.setAttribute(
            'title',
            nextMode === 'white' ? '切换为黑色背景' : '切换为白色背景'
          );
        });
      }

      const mode = container.classList.contains('lg-bg-white') ? 'white' : 'black';
      toggleButton.setAttribute(
        'aria-label',
        mode === 'white' ? '切换为黑色背景' : '切换为白色背景'
      );
      toggleButton.setAttribute(
        'title',
        mode === 'white' ? '切换为黑色背景' : '切换为白色背景'
      );
    };

    lgAny.LGel?.off?.('lgAfterOpen.bgToggle');
    lgAny.LGel?.on?.('lgAfterOpen.bgToggle', onAfterOpen);
  }

  function enableImageLightbox() {
    if (lgInstance) { lgInstance.destroy(); lgInstance = null; }
    const article = document.getElementById('article');
    if (!article) return;

    const imgs = Array.from(article.querySelectorAll('img'))
      .filter(img => !img.closest('a'));
    if (!imgs.length) return;

    const dynamicEl = imgs.map(img => ({
      src: img.src,
      thumb: img.src,
      alt: img.alt || '',
    }));

    lgInstance = lightGallery(document.body, {
      dynamic: true,
      dynamicEl,
      plugins: [lgZoom],
      speed: 400,
      zoom: true,
      showZoomInOutIcons: true,
      actualSize: false,
      download: false,
      licenseKey: '0000-0000-000-0000',
    });
    attachLightboxBgToggle(lgInstance);

    imgs.forEach((img, idx) => {
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', () => lgInstance!.openGallery(idx));
    });
  }

  document.addEventListener('astro:page-load', enableImageLightbox);
</script>
